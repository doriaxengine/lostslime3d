id: 4193952127
name: Title Menu
scene:
  backgroundColor: [0.07, 0.12, 0.2, 1]
  shadowQuality: low
  meshLodEnabled: false
  meshLodThreshold: 1
  depthPrepassEnabled: false
  lightState: off
  globalIlluminationIntensity: 0.1
  globalIlluminationColor: [1, 1, 1]
  ambientLight2DIntensity: 1
  ambientLight2DColor: [1, 1, 1]
  shadow2DQuality: low
  ssaoEnabled: false
  ssaoRadius: 0.5
  ssaoIntensity: 1
  ssaoBias: 0.025
  ssrEnabled: false
  ssrMaxDistance: 8
  ssrThickness: 0.5
  ssrMaxSteps: 48
  ssrIntensity: 1
  ssrBlur: 0
  gravity2D: [0, -9.81]
  gravity3D: [0, -20, 0]
  fixedResolutionEnabled: false
  fixedResolutionWidth: 640
  fixedResolutionHeight: 360
  fixedResolutionFilter: nearest
  enableUIEvents: not_set
sceneType: scene_ui
mainCamera: 0
maxValues:
  maxSubmeshes: 0
  maxTilemapTilesRect: 0
  maxTilemapTiles: 0
  maxExternalBuffers: 0
  maxSpriteFrames: 0
  maxBones: 70
  maxShapes2D: 0
  maxShapePoints2D: 0
  maxShapes3D: 0
  maxShapeVertices3D: 0
  maxShapeIndices3D: 0
shaderKeys:
  - type: ui
    properties: 2
  - type: ui
    properties: 8
  - type: ui
    properties: 9
  - type: blit
cppScripts:
  - path: scripts/MenuController.cpp
    headerPath: scripts/MenuController.h
    className: MenuController
    properties:
      - name: primaryAction
        isPtr: false
      - name: primaryScene
        isPtr: false
      - name: escapeAction
        isPtr: false
      - name: escapeScene
        isPtr: false
      - name: scoreText
        isPtr: true
        ptrTypeName: doriax::Text
      - name: bestText
        isPtr: true
        ptrTypeName: doriax::Text
      - name: helpText
        isPtr: true
        ptrTypeName: doriax::Text
      - name: touchHelp
        isPtr: false
      - name: jingle
        isPtr: false
  - path: scripts/MenuButton.cpp
    headerPath: scripts/MenuButton.h
    className: MenuButton
    properties:
      - name: action
        isPtr: false
      - name: targetScene
        isPtr: false
entities:
  - type: Entity
    entity: 1050
    name: Menu
    components:
      script:
        scripts:
          - type: cpp
            path: scripts/MenuController.cpp
            headerPath: scripts/MenuController.h
            className: MenuController
            enabled: true
            properties:
              - name: primaryAction
                displayName: Primary Action
                type: String
                value: play
                defaultValue: play
              - name: primaryScene
                displayName: Primary Scene
                type: String
                value: Level One
                defaultValue: Level One
              - name: escapeAction
                displayName: Escape Action
                type: String
                value: ""
                defaultValue: ""
              - name: escapeScene
                displayName: Escape Scene
                type: String
                value: Intro Scene
                defaultValue: Intro Scene
              - name: scoreText
                displayName: Score Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 0
                defaultValue: 0
              - name: bestText
                displayName: Best Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 1063
                defaultValue: 0
                sceneId: 4193952127
              - name: helpText
                displayName: Help Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 1040
                defaultValue: 0
                sceneId: 4193952127
              - name: touchHelp
                displayName: Touch Help
                type: String
                value: "Move with the stick, push it all the way to run\nJump with the right button, drag to look around"
                defaultValue: ""
              - name: jingle
                displayName: Jingle
                type: String
                value: ""
                defaultValue: ""
  - type: Entity
    entity: 1060
    name: Click Sound
    components:
      sound:
        state: stopped
        filename: audio/click.ogg
        enableClocked: false
        volume: 0.5
        speed: 1
