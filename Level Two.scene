    properties:
      - name: sceneName
        isPtr: false
      - name: levelTitle
        isPtr: false
      - name: nextScene
        isPtr: false
      - name: spawnPoint
        isPtr: true
        ptrTypeName: doriax::Object
      - name: completionBonus
        isPtr: false
