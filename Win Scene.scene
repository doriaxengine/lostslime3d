  - type: Entity
    entity: 1074
    name: Menu
    components:
      script:
        scripts:
          - type: cpp
            path: scripts/MenuController.cpp
            headerPath: scripts/MenuController.h
            className: MenuController
            enabled: true
            properties:
              - name: primaryAction
                displayName: Primary Action
                type: String
                value: play
                defaultValue: play
              - name: primaryScene
                displayName: Primary Scene
                type: String
                value: Level One
                defaultValue: Level One
              - name: escapeAction
                displayName: Escape Action
                type: String
                value: menu
                defaultValue: ""
              - name: escapeScene
                displayName: Escape Scene
                type: String
                value: Intro Scene
                defaultValue: Intro Scene
              - name: scoreText
                displayName: Score Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 1068
                defaultValue: 0
                sceneId: 3285055825
              - name: bestText
                displayName: Best Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 1069
                defaultValue: 0
                sceneId: 3285055825
              - name: helpText
                displayName: Help Text
                type: EntityReference
                ptrTypeName: doriax::Text
                value: 0
                defaultValue: 0
              - name: touchHelp
                displayName: Touch Help
                type: String
                value: ""
                defaultValue: ""
              - name: jingle
                displayName: Jingle
                type: String
                value: Win Jingle
                defaultValue: ""
